# Supabase (Dashboard → Project Settings → API). Can also be set directly in src/config/supabase.ts.
# Only the PUBLISHABLE key goes here — never the secret / service_role key.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# VITE_LOCAL_ONLY: set to "true" (e.g. in .env.development.local) to keep accounts and data only in the
# browser, without touching the Supabase project — useful for development/testing.
# VITE_LOCAL_ONLY="true"
