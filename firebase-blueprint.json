{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "university": { "type": "string" },
        "currentSemesterId": { "type": "string" },
        "dreamSpecialty": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "totalXp": { "type": "number" },
        "level": { "type": "number" },
        "currentStreakDays": { "type": "number" },
        "bestStreakDays": { "type": "number" },
        "darkMode": { "type": "boolean" },
        "soundEnabled": { "type": "boolean" },
        "onboardingCompleted": { "type": "boolean" }
      },
      "required": ["uid", "name", "email"]
    },
    "Semester": {
      "title": "Semester",
      "description": "Academic semester definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "year": { "type": "number" },
        "isCurrent": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Medical subject / discipline",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "semesterId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "color": { "type": "string" },
        "professor": { "type": "string text" },
        "targetHours": { "type": "number" },
        "studiedHours": { "type": "number" },
        "targetGrade": { "type": "number" },
        "currentGrade": { "type": "number" }
      },
      "required": ["id", "semesterId", "name"]
    },
    "Topic": {
      "title": "Topic",
      "description": "Study topic inside a subject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "difficulty": { "type": "string" },
        "priority": { "type": "string text" },
        "relevanceForResidencia": { "type": "number" },
        "summary": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "subjectId", "title"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Academic or residency exam",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "weight": { "type": "number" },
        "grade": { "type": "number" }
      },
      "required": ["id", "subjectId", "title", "date"]
    },
    "ScheduleClass": {
      "title": "ScheduleClass",
      "description": "Weekly class schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "dayOfWeek": { "type": "number" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["id", "subjectId", "dayOfWeek", "startTime", "endTime"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Completed study session or pomodoro",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "notes": { "type": "string" },
        "xpEarned": { "type": "number" }
      },
      "required": ["id", "subjectId", "durationMinutes", "timestamp"]
    },
    "AppDataState": {
      "title": "AppDataState",
      "description": "Persisted academic progress, statistics and user configuration",
      "type": "object",
      "properties": {
        "userProfile": { "type": "object" },
        "semesters": { "type": "array" },
        "subjects": { "type": "array" },
        "topics": { "type": "array" },
        "exams": { "type": "array" },
        "schedule": { "type": "array" },
        "achievements": { "type": "array" },
        "medRevisions": { "type": "array" },
        "studySessions": { "type": "array" },
        "pomodoroSettings": { "type": "object" },
        "tutorMessages": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/appData/{docId}": {
      "schema": "AppDataState",
      "description": "User academic progress, profile and statistics synchronization document"
    },
    "/users/{userId}/semesters/{semesterId}": {
      "schema": "Semester",
      "description": "User semesters collection"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "User subjects collection"
    },
    "/users/{userId}/topics/{topicId}": {
      "schema": "Topic",
      "description": "User topics collection"
    },
    "/users/{userId}/exams/{examId}": {
      "schema": "Exam",
      "description": "User exams collection"
    },
    "/users/{userId}/schedule/{classId}": {
      "schema": "ScheduleClass",
      "description": "User schedule collection"
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": "StudySession",
      "description": "User study sessions collection"
    }
  }
}
