rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health and connection check endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles and all user-owned nested academic subcollections
    match /users/{userId} {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Default deny for all other unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

