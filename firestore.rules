rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write for user profiles and user app data to enable seamless cross-device account lookup and cloud sync
    match /users/{userId} {
      allow read, write: if true;

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
